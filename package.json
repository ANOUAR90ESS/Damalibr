{
  "name": "lamina",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.2.14",
  "engines": {
    "node": ">=22.12.0",
    "bun": "1.2.14"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:client": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && bun run build:server",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "db:seed": "tsx scripts/generate-seed.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
